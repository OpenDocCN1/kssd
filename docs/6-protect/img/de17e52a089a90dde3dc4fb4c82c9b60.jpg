<script>
	$(function(){

		$(".loding_more").click(function(){

            var _this = this;

            $(_this).html('<img src="https://www.kanxue.com/view/img/newhome3/loading.gif" alt="">加载中...');
            var page = parseInt($(_this).attr("data-page"))+1;
			var zhuanlanurl = '//'+'www.kanxue.com'+'/homepost-morearticle.htm';
           
			$.xpost(zhuanlanurl,{
                page: page,
                pagesize: 10
        	}, function(code, message) {
				if(code == 0) {
                    var str='';
                    var author_url = '';
                    for (var i = 0; i < message.list.length; i++) {
                        str += '<div class="media py-4 home_article" style="overflow: hidden;">';
                        str += '<div class="mr-4 article-img" style="width: 160px; height: 120px;border-radius: 4px;background: url(//zhuanlan.kanxue.com/'+message.list[i].pic_fmt+') no-repeat;background-size: cover;background-position: center;"></div>'
                        str += ' <div class="media-body">';
                        if(message.list[i].is_bbs_digest == 0) {
                            str += ' <a href="//zhuanlan.kanxue.com/article-'+message.list[i].articleid+'.htm"  target="_blank" class="article_url">';
                            author_url = '//zhuanlan.kanxue.com/user-'+message.list[i].userinfo.uid+'.htm';
                        } else {
                            str += ' <a href="'+message.list[i].source_url +'" target="_blank" class="article_url">';
                            author_url = '//bbs.pediy.com/user-'+message.list[i].uid+'.htm';
                        }
                       
                        str += ' <h4 class="mt-0 article_title">'+message.list[i].subject+'</h4>';
                        str += ' <div class="article-excerpt" style="margin-bottom:5px!important;">';
                        str += message.list[i].brief;
                        str += '</div></a><div class="row mb-1">';
                        // str += '<span style="border: 1px solid https://www.kanxue.com/bbb; color: https://www.kanxue.com/bbb; border-radius: 10px; padding: 0px 5px; margin-left: 4px;" class="small hidden-sm hidden-md ml-2">'+message.list[i].tags[0]+'</span>';
                        // str += '<span style="border: 1px solid https://www.kanxue.com/bbb; color: https://www.kanxue.com/bbb; border-radius: 10px; padding: 0px 5px; margin-left: 4px;" class="small hidden-sm hidden-md ml-2">'+message.list[i].tags[1]+'</span>';
                        str += '</div><div class="row"> <div class="col-3">';
                        str += '<a href="'+author_url+'" class="article_author"><img src="'+message.list[i].userinfo.avatar_url+'" class="avatar-1" /></a>';
                        str += '<a href="'+author_url+'" class="article_author">'+message.list[i].userinfo.username+'</a> </div>';
                        str += '<div class="col-9 text-right" style="color: https://www.kanxue.com/888;">';
                        if(message.list[i].is_bbs_digest == 0) {
                            str += '已有 <span class="read_number_style">'+message.list[i].views+'</span> 人阅读・<span>'+message.list[i].create_date+'</span>';
                        } else {
                            str += '<span>'+message.list[i].create_date+'</span>';
                        }
                        str += '</div></div></div></div>';
                        
                    }
                    $(".loadingmore_box").before(str);
                    $(_this).attr("data-page", message.page);
                    $(_this).html("加载更多");
			    } else {
			    	$.alert('错误：'+message);
			    }
			})
		})

        function random_courses(obj,i,weburl,message) {
            obj.find(".course_url").attr("href",weburl+'/book-'+message[i]['id']+'.htm');
            obj.find(".course_cover").attr("src",weburl+message[i]['pic']);
            obj.find(".course_title").text(message[i]['title']);
            
        }
        $(".change_course_btn").click(function(){
            $(this).find('i').remove();
            var _this = this;
            $(_this).html('<img src="https://www.kanxue.com/view/img/newhome3/loading.gif" alt="">加载中...');
            var courseurl = '//'+'www.kanxue.com'+'/homepost-morecourse.htm';
            var random_course = $(".random_course");
            var weburl = '//'+'www.kanxue.com';
            $.xpost(courseurl,{}, function(code, message) {

                for (var i = 0; i < message.length; i++) {
                    switch (i) {
                        case 0:
                            var obj = random_course.children("div:nth-child(1)");
                            random_courses(obj,i,weburl,message);
                            break;
                        case 1:
                            var obj1 = random_course.children("div:nth-child(2)");
                            random_courses(obj1,i,weburl,message);
                            break;
                        case 2:
                            var obj2 = random_course.children("div:nth-child(3)");
                            random_courses(obj2,i,weburl,message);
                            break;
                        default:
                            break;
                    }
                    $(_this).html('<i class="fa fa-refresh"></i> 换一批');
                }
            })

        })
        function random_jobs(obj,i,weburl,message) {
            obj.find(".job_url").attr("href",weburl+'position-read-'+message[i]['positionid']+'.htm');
            obj.find(".job_cover").attr("src",weburl+message[i]['logo_img_url']);
            obj.find(".job_title").text(message[i]['subject']);
            obj.find(".job_fmt").html(message[i]['work_year_fmt']+'/'+message[i]['degree_fmt']);
            obj.find(".job_salary").html(message[i]['salary_fmt']);
            obj.find(".job_company_name").text(message[i]['name']);
            obj.find(".job_company_fmt").html(message[i]['financing_fmt']+'/'+message[i]['city_name']);

        }
        $(".change_job_btn").click(function(){
            $(this).find("i").remove();
            var _this = this;
            $(_this).html('<img src="https://www.kanxue.com/view/img/newhome3/loading.gif" alt="">加载中...');

            var joburl = '//'+'www.kanxue.com'+'/homepost-morejob.htm';
            var random_job = $(".random_job");
            var weburl = '//'+'job.kanxue.com'+'/';
            $.xpost(joburl,{}, function(code, message) {
                for (var i = 0; i < message.length; i++) {
                    switch (i) {
                        case 0:
                            var obj = random_job.children("div:nth-child(1)");
                            random_jobs(obj,i,weburl,message);
                            
                            break;
                        case 1:
                            var obj1 = random_job.children("div:nth-child(2)");
                            random_jobs(obj1,i,weburl,message);
                            break;
                        case 2:
                            var obj2 = random_job.children("div:nth-child(3)");
                            random_jobs(obj2,i,weburl,message);
                            break;
                        default:
                            break;
                    } 
                   
                    $(_this).html('<i class="fa fa-refresh"></i> 换一批');
                }
            })

        })
        var huoyuezhuanlan_str='';
        $.xget('//'+'zhuanlan.kanxue.com'+'/user-get_fieldlist.htm',function(code, message){

            if (code == 0) {
                for (var i = 0; i < message.length; i++) {
                    // console.log(message[i]);
                    huoyuezhuanlan_str += '<div class="py-4" style="border-bottom: 1px solid https://www.kanxue.com/e9e9e9;"><div class="row mx-0"><div class="col-8 px-2"><div class="media">';
                    huoyuezhuanlan_str += '<img class="avatar-3 mr-2" src="//zhuanlan.kanxue.com/'+message[i].avatar_img_url+'" >';
                    huoyuezhuanlan_str += '<div class="media-body"><div class="d-inline-block h6 m-0 nowrap" style="max-width: 124px;">';
                    huoyuezhuanlan_str += message[i].name;
                    huoyuezhuanlan_str += '</div><div style="font-size: 12px; color: https://www.kanxue.com/0099ee;">';
                    huoyuezhuanlan_str += '作者：'+message[i].username;
                    huoyuezhuanlan_str += '</div></div></div></div><div class="col-4 text-right">';
                    if (message[i].isfollow == 1) {
                    huoyuezhuanlan_str += '<button type="button" class="btn btn-sm py-0 my-1 zhuanlan_follow_btn" data-uid="'+message[i].uid+'" data-follow="'+message[i].isfollow+'" style="background: https://www.kanxue.com/dcdcdc; color: #fff;">已关注</button>';
                    } else if(message[i].isfollow == 0){
                    huoyuezhuanlan_str += '<button type="button" class="btn btn-sm py-0 my-1 zhuanlan_follow_btn" data-uid="'+message[i].uid+'" data-follow="'+message[i].isfollow+'" style="background: https://www.kanxue.com/0099ee; color: #fff;">关注</button>';
                    }

                    huoyuezhuanlan_str += '</div></div><div class="color888 px-2 mt-3 column-excerpt">';
                    huoyuezhuanlan_str += message[i].brief;
                    huoyuezhuanlan_str += '</div></div>';
                }
                // console.log(huoyuezhuanlan_str);
                $('.active_column').append(huoyuezhuanlan_str);
                zhuanlan_follow();
            }

        })
        function zhuanlan_follow(){
            $(".zhuanlan_follow_btn").on("click",function(){
                var _this = this;
                var zhuanlan_uid = $(this).attr("data-uid");

                $.xget('//'+'zhuanlan.kanxue.com'+'/user-get_follow-'+zhuanlan_uid+'.htm', function(code, message) {
                    if (code == 0) {
                        $(_this).text('已关注');
                        $(_this).css("background", "https://www.kanxue.com/dcdcdc");
                    } else if (code == 1) {
                        $(_this).text('关注');
                        $(_this).css("background", "https://www.kanxue.com/0099ee");
                    } else if(code == -1) {
                        $.alert(message);
                    } 
                })
            })
        }
  //       console.log($(window).scrollTop())
		
		// setTimeout(function(){
  //           if ($(window).scrollTop() == 0) {
  //               $('.header_fiexd').css("display","block");
  //           } else {
  //               $('.header_fiexd').css("display","none");
  //           }
  //       },0);
  $(".price").each(function(index,ele){
            v = $(ele).text();
            if(v === ''){  
                v = '0.00';  
            }else if(v === '0'){  
                v = '0.00';  
            }else if(v === '0.'){  
                v = '0.00';  
            }else if(/^0+\d+\.?\d*.*$/.test(v)){  
                v = v.replace(/^0+(\d+\.?\d*).*$/, '$1');  
                v = inp.getRightPriceFormat(v).val;  
            }else if(/^0\.\d$/.test(v)){  
                v = v + '0';  
            }else if(!/^\d+\.\d{2}$/.test(v)){  
                if(/^\d+\.\d{2}.+/.test(v)){  
                    v = v.replace(/^(\d+\.\d{2}).*$/, '$1');  
                }else if(/^\d+$/.test(v)){  
                    v = v + '.00';  
                }else if(/^\d+\.$/.test(v)){  
                    v = v + '00';  
                }else if(/^\d+\.\d$/.test(v)){  
                    v = v + '0';  
                }else if(/^[^\d]+\d+\.?\d*$/.test(v)){  
                    v = v.replace(/^[^\d]+(\d+\.?\d*)$/, '$1');  
                }else if(/\d+/.test(v)){  
                    v = v.replace(/^[^\d]*(\d+\.?\d*).*$/, '$1');  
                    ty = false;  
                }else if(/^0+\d+\.?\d*$/.test(v)){  
                    v = v.replace(/^0+(\d+\.?\d*)$/, '$1');  
                    ty = false;  
                }else{  
                    v = '0.00';  
                }  
            }  
            $(this).html('<i class="fa fa-jpy"></i> '+v);   
        });
        
	})

</script>









